# Basis-URL van de publieke R2-bucket waar Payload de media van deze tenant zet.
# Objecten staan onder tenants/<PUBLIC_TENANT_SLUG>/<bestandsnaam>.
R2_PUBLIC_URL=https://pub-d4024ad3e57841448e0ee58a19abe46b.r2.dev

# Zelfde waarde, maar beschikbaar in de Astro/Vite-build (client-side).
PUBLIC_R2_URL=https://pub-d4024ad3e57841448e0ee58a19abe46b.r2.dev

# Moet gelijk zijn aan tenantSlug in astropayload.config.json.
PUBLIC_TENANT_SLUG=lokaalnieuwstilburg

# Optioneel: alleen nodig als deze repo zelf uit Payload wil synchroniseren.
# Zonder PAYLOAD_API_KEY slaat scripts/sync-blog-from-payload.mjs zichzelf over.
# PAYLOAD_URL=https://payload.10beste.com
# PAYLOAD_API_KEY=
# PAYLOAD_SYNC_SKIP=1
