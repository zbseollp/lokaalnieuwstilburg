---
import BaseLayout from "./BaseLayout.astro";
const { title, description, pubDate, category, author, heroImage, imageAlt } = Astro.props;
const dateStr = new Date(pubDate).toLocaleDateString("nl-NL", { day: "numeric", month: "long", year: "numeric" });
---
<BaseLayout {title} {description} image={heroImage} type="article">
  <article class="article-page">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/blog/">Nieuws</a>
        <span>/</span>
        <span>{title}</span>
      </nav>

      <div class="article-wrap">
        <div class="article-main">
          <div class="article-meta-top">
            <span class="cat-badge">{category}</span>
            <time datetime={new Date(pubDate).toISOString()}>{dateStr}</time>
            <span>Door {author}</span>
          </div>

          <h1 class="article-title">{title}</h1>

          {description && <p class="article-lead">{description}</p>}

          {heroImage && (
            <figure class="article-hero">
              <img src={heroImage} alt={imageAlt || title} loading="eager" />
            </figure>
          )}

          <div class="prose">
            <slot />
          </div>

          <div class="article-share">
            <span>Deel dit artikel:</span>
            <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(Astro.url.href)}`} target="_blank" rel="noopener" class="share-btn share-fb">Facebook</a>
            <a href={`https://wa.me/?text=${encodeURIComponent(title + " " + Astro.url.href)}`} target="_blank" rel="noopener" class="share-btn share-wa">WhatsApp</a>
          </div>
        </div>

        <aside class="article-sidebar">
          <div class="sidebar-widget">
            <h3>Meer nieuws</h3>
            <a href="/blog/" class="btn-more">Alle artikelen &rarr;</a>
          </div>
          <div class="sidebar-widget">
            <h3>Lokale info</h3>
            <ul class="sidebar-links">
              <li><a href="/evenementen/">Evenementen</a></li>
              <li><a href="/bekendmakingen/">Bekendmakingen</a></li>
              <li><a href="/vacatures-tilburg/">Vacatures</a></li>
              <li><a href="/bedrijvengids/">Bedrijvengids</a></li>
              <li><a href="/funda-tilburg/">Woningen</a></li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
.article-page { padding: 1rem 0 3rem; }
.container { max-width: 1200px; margin: 0 auto; padding: 0 1rem; }
.breadcrumb { display: flex; gap: 0.5rem; font-size: 0.8rem; color: var(--color-muted); margin-bottom: 1.5rem; flex-wrap: wrap; }
.breadcrumb a { color: var(--color-muted); } .breadcrumb a:hover { color: var(--color-brand); }
.article-wrap { display: grid; grid-template-columns: 1fr 300px; gap: 3rem; }
.article-meta-top { display: flex; align-items: center; gap: 0.75rem; font-size: 0.8rem; color: var(--color-muted); margin-bottom: 0.75rem; flex-wrap: wrap; }
.cat-badge { background: var(--color-brand); color: white; padding: 0.2rem 0.6rem; border-radius: 4px; font-weight: 600; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.03em; }
.article-title { font-size: clamp(1.5rem, 3vw, 2.25rem); font-weight: 800; line-height: 1.2; margin: 0 0 1rem; }
.article-lead { font-size: 1.1rem; color: #374151; line-height: 1.6; border-left: 3px solid var(--color-brand); padding-left: 1rem; margin-bottom: 1.5rem; }
.article-hero { margin: 0 0 2rem; border-radius: 8px; overflow: hidden; }
.article-hero img { width: 100%; max-height: 450px; object-fit: cover; display: block; }
.article-share { display: flex; align-items: center; gap: 0.75rem; margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--color-border); font-size: 0.875rem; color: var(--color-muted); }
.share-btn { padding: 0.35rem 0.9rem; border-radius: 4px; font-size: 0.8rem; font-weight: 600; }
.share-fb { background: #1877F2; color: white; }
.share-wa { background: #25D366; color: white; }
.article-sidebar { padding-top: 0.5rem; }
.sidebar-widget { background: var(--color-surface); border-radius: 8px; padding: 1.25rem; margin-bottom: 1rem; }
.sidebar-widget h3 { font-size: 0.875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-muted); margin: 0 0 0.75rem; }
.btn-more { display: inline-block; background: var(--color-brand); color: white; padding: 0.4rem 1rem; border-radius: 4px; font-size: 0.875rem; font-weight: 600; }
.sidebar-links { list-style: none; padding: 0; margin: 0; }
.sidebar-links li a { display: block; padding: 0.35rem 0; font-size: 0.875rem; color: var(--color-ink); border-bottom: 1px solid var(--color-border); }
.sidebar-links li:last-child a { border-bottom: none; }
.sidebar-links li a:hover { color: var(--color-brand); }
@media (max-width: 900px) {
  .article-wrap { grid-template-columns: 1fr; }
  .article-sidebar { display: none; }
}
</style>
