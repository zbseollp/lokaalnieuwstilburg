---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogPostGrid from "../../components/BlogPostGrid.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths({ paginate }: { paginate: Function }) {
  const allPosts = await getCollection("blog", ({ data }: { data: any }) => !data.draft);
  const posts = allPosts.sort((a: any, b: any) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return paginate(posts, { pageSize: 12 });
}

const { page } = Astro.props as any;
const posts = page.data;
---
<BaseLayout title={`${page.currentPage === 1 ? "Blog pagina LokaalnieuwsTilburg.nl Lees alle berichten" : `Nieuws - pagina ${page.currentPage}`}`} description="Lees alle lokale nieuwsartikelen over Tilburg en omgeving op LokaalnieuwsTilburg.nl.">
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a><span>/</span><span>Nieuws</span>
    </nav>
    <h1 class="page-title">Lokaal Nieuws Tilburg</h1>
    <p class="page-intro">{page.total} artikelen over Tilburg en omgeving.</p>

    <BlogPostGrid posts={posts} featuredFirst={page.currentPage === 1} />

    {page.lastPage > 1 && (
      <nav class="pagination" aria-label="Paginering">
        {page.url.prev && (
          <a href={page.url.prev} class="page-btn">&larr; Vorige</a>
        )}
        {Array.from({ length: page.lastPage }, (_, i) => i + 1).map(n => (
          <a
            href={n === 1 ? "/blog/" : `/blog/${n}/`}
            class:list={["page-num", { active: n === page.currentPage }]}
            aria-current={n === page.currentPage ? "page" : undefined}
          >{n}</a>
        ))}
        {page.url.next && (
          <a href={page.url.next} class="page-btn">Volgende &rarr;</a>
        )}
      </nav>
    )}
  </div>
</BaseLayout>

<style>
.container { max-width: 1200px; margin: 0 auto; padding: 1rem 1rem 3rem; }
.breadcrumb { display: flex; gap: 0.5rem; font-size: 0.8rem; color: var(--color-muted); margin-bottom: 1.5rem; }
.breadcrumb a { color: var(--color-muted); } .breadcrumb a:hover { color: var(--color-brand); }
.page-title { font-size: 2rem; font-weight: 800; margin: 0 0 0.5rem; }
.page-intro { color: var(--color-muted); margin: 0 0 1.5rem; }
.pagination { display: flex; align-items: center; justify-content: center; gap: 0.4rem; margin-top: 3rem; flex-wrap: wrap; }
.page-btn { padding: 0.5rem 1rem; border: 1px solid var(--color-border); border-radius: 6px; font-size: 0.85rem; color: var(--color-brand); font-weight: 600; transition: all 0.15s; }
.page-btn:hover { background: var(--color-brand); color: white; border-color: var(--color-brand); }
.page-num { width: 2.2rem; height: 2.2rem; display: flex; align-items: center; justify-content: center; border-radius: 6px; font-size: 0.85rem; font-weight: 500; border: 1px solid var(--color-border); color: var(--color-muted); transition: all 0.15s; }
.page-num:hover { background: var(--color-surface); color: var(--color-brand); }
.page-num.active { background: var(--color-brand); color: white; border-color: var(--color-brand); font-weight: 700; }
</style>
