---
import CategoriePagina from "../../components/CategoriePagina.astro";
import paginas from "../../data/categoriepaginas";
import bedrijven from "../../data/bedrijven.json";
const filtered = (bedrijven as any[]).filter(b => ["Gebedstijden"].includes(b.category));
const content = paginas["gebedstijden-tilburg"];
---
<CategoriePagina slug="gebedstijden-tilburg" content={content} bedrijven={filtered} noBedrijven={true} breadcrumbParent={{ label: "Bedrijvengids", href: "/bedrijvengids/" }} />
