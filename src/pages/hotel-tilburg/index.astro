---
import CategoriePagina from "../../components/CategoriePagina.astro";
import paginas from "../../data/categoriepaginas";
import bedrijven from "../../data/bedrijven.json";
const filtered = (bedrijven as any[]).filter(b => ["Hotel"].includes(b.category));
const content = paginas["hotel-tilburg"];
---
<CategoriePagina slug="hotel-tilburg" content={content} bedrijven={filtered} breadcrumbParent={{ label: "Bedrijvengids", href: "/bedrijvengids/" }} />
