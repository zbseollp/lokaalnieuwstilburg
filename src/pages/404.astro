---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Pagina niet gevonden" noindex={true}>
  <div class="container">
    <div class="error-page">
      <span class="error-code">404</span>
      <h1>Pagina niet gevonden</h1>
      <p>De pagina die u zoekt bestaat niet of is verplaatst.</p>
      <div class="error-links">
        <a href="/" class="btn-primary">Naar de homepage</a>
        <a href="/blog/" class="btn-secondary">Bekijk nieuws</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
.container { max-width: 600px; margin: 0 auto; padding: 4rem 1rem; text-align: center; }
.error-code { font-size: 6rem; font-weight: 800; color: var(--color-brand); opacity: 0.15; display: block; line-height: 1; }
h1 { font-size: 2rem; font-weight: 800; margin: 0 0 0.5rem; }
p { color: var(--color-muted); margin: 0 0 2rem; }
.error-links { display: flex; gap: 1rem; justify-content: center; }
.btn-primary { background: var(--color-brand); color: white; padding: 0.6rem 1.5rem; border-radius: 6px; font-weight: 600; }
.btn-secondary { border: 1px solid var(--color-border); color: var(--color-ink); padding: 0.6rem 1.5rem; border-radius: 6px; font-weight: 600; }
</style>
