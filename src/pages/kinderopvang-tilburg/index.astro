---
import CategoriePagina from "../../components/CategoriePagina.astro";
import paginas from "../../data/categoriepaginas";
import bedrijven from "../../data/bedrijven.json";
const filtered = (bedrijven as any[]).filter(b => ["Kinderopvang", "Naschoolse opvang"].includes(b.category));
const content = paginas["kinderopvang-tilburg"];
---
<CategoriePagina slug="kinderopvang-tilburg" content={content} bedrijven={filtered} breadcrumbParent={{ label: "Bedrijvengids", href: "/bedrijvengids/" }} />
