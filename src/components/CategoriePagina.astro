---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { CategoriePagina } from "../data/categoriepaginas";
import alleBedrijven from "../data/bedrijven.json";

interface Props {
  slug: string;
  content: CategoriePagina;
  bedrijven?: any[];
  breadcrumbParent?: { label: string; href: string };
  noBedrijven?: boolean;
}

const { slug, content, bedrijven = [], breadcrumbParent, noBedrijven = false } = Astro.props;

function makeSlug(str: string): string {
  if (!str) return 'onbekend';
  return str.toLowerCase()
    .normalize('NFD').replace(/[̀-ͯ]/g, '')
    .replace(/['"]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '') || 'onbekend';
}

// Build the same slug-map as [slug].astro so links are consistent
const slugMap = new Map<string, string>();
const seen = new Map<string, number>();
for (const b of alleBedrijven as any[]) {
  const base = makeSlug(b.title);
  const count = seen.get(base) ?? 0;
  seen.set(base, count + 1);
  const bslug = count === 0 ? base : `${base}-${count + 1}`;
  const key = (b.title || '') + (b.street || '');
  if (!slugMap.has(key)) slugMap.set(key, bslug);
}

function getBedrijfSlug(b: any): string {
  return slugMap.get((b.title || '') + (b.street || '')) ?? makeSlug(b.title);
}
---
<BaseLayout title={content.seoTitel || content.titel} description={content.beschrijving}>
  <div class="container">
    <nav class="breadcrumb">
      <a href="/">Home</a><span>/</span>
      {breadcrumbParent && <><a href={breadcrumbParent.href}>{breadcrumbParent.label}</a><span>/</span></>}
      <span>{content.titel}</span>
    </nav>

    <div class="page-grid">
      <main>
        <h1>{content.titel}</h1>
        <p class="intro">{content.intro}</p>

        <slot />

        {!noBedrijven && (bedrijven.length > 0 ? (
          <div class="bedrijven-grid">
            {bedrijven.map((b: any) => (
              <div class="card">
                <span class="cat">{b.category}</span>
                <h3>{b.title}</h3>
                {b.street && <p>{b.street}{b.city ? ", " + b.city : ""}</p>}
                {b.phone && <p><a href={"tel:" + b.phone}>{b.phone}</a></p>}
                <div class="actions">
                  <a href={`/${getBedrijfSlug(b)}/`} class="btn btn-detail">Meer info</a>
                  {b.website && <a href={b.website} target="_blank" rel="noopener" class="btn">Website</a>}
                  {b.mapsUrl && <a href={b.mapsUrl} target="_blank" rel="noopener" class="btn btn-map">Kaart</a>}
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div class="geen-bedrijven">
            <p>Er zijn momenteel geen bedrijven in dit overzicht. Wil je jouw bedrijf toevoegen? <a href="/contact/">Neem contact op</a>.</p>
          </div>
        ))}

        <div class="tekst-blok">
          {content.tekst.map(alinea =>
            alinea.startsWith("H2: ")
              ? <h2>{alinea.slice(4)}</h2>
              : alinea.startsWith("H3: ")
                ? <h3>{alinea.slice(4)}</h3>
                : <p>{alinea}</p>
          )}
        </div>
      </main>

      <aside>
        {content.gerelateerd && content.gerelateerd.length > 0 && (
          <div class="sidebar-blok">
            <h3>Gerelateerd</h3>
            <ul>
              {content.gerelateerd.map(link => (
                <li><a href={link.href}>{link.label}</a></li>
              ))}
            </ul>
          </div>
        )}
        <div class="sidebar-blok">
          <h3>Bedrijf toevoegen?</h3>
          <p>Staat uw bedrijf er niet bij? Meld het gratis aan.</p>
          <a href="/contact/" class="btn-cta">Bedrijf aanmelden</a>
        </div>
        <div class="sidebar-blok">
          <h3>Lokaal nieuws</h3>
          <p>Blijf op de hoogte van het laatste nieuws uit Tilburg.</p>
          <a href="/blog/" class="btn-cta btn-cta--outline">Lees nieuws</a>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
.container { max-width: 1100px; margin: 0 auto; padding: 1rem 1rem 3rem; }
.breadcrumb { display: flex; gap: .5rem; font-size: .8rem; color: var(--color-muted); margin-bottom: 1.5rem; flex-wrap: wrap; }
.breadcrumb a { color: var(--color-muted); } .breadcrumb a:hover { color: var(--color-brand); }

.page-grid { display: grid; grid-template-columns: 1fr 260px; gap: 2.5rem; align-items: start; }

h1 { font-size: 2rem; font-weight: 800; margin: 0 0 .5rem; }
.intro { color: var(--color-muted); margin: 0 0 1.75rem; font-size: 1rem; line-height: 1.65; }

.bedrijven-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin-bottom: 2rem; }
.card { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 8px; padding: 1rem; transition: border-color .15s; }
.card:hover { border-color: var(--color-brand); }
.cat { font-size: .68rem; color: var(--color-brand); font-weight: 700; text-transform: uppercase; }
.card h3 { font-size: .95rem; font-weight: 700; margin: .25rem 0 .4rem; }
.card p { font-size: .8rem; color: var(--color-muted); margin: 0 0 .25rem; }
.card p a { color: var(--color-brand); }
.actions { display: flex; gap: .4rem; margin-top: .5rem; }
.btn { padding: .25rem .65rem; border-radius: 4px; font-size: .75rem; font-weight: 600; background: var(--color-brand); color: white; }
.btn-detail { background: transparent; border: 1px solid var(--color-brand); color: var(--color-brand); }
.btn-map { background: #1B4F8A; }

.geen-bedrijven { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 8px; padding: 1.25rem; margin-bottom: 2rem; font-size: .9rem; color: var(--color-muted); }
.geen-bedrijven a { color: var(--color-brand); font-weight: 600; }

.tekst-blok { border-top: 2px solid var(--color-border); padding-top: 1.5rem; }
.tekst-blok p { font-size: .9rem; color: #374151; line-height: 1.8; margin: 0 0 1rem; }
.tekst-blok h2 { font-size: 1.25rem; font-weight: 800; color: #111; margin: 1.75rem 0 0.6rem; line-height: 1.3; }
.tekst-blok h3 { font-size: 1.05rem; font-weight: 700; color: #111; margin: 1.4rem 0 0.5rem; line-height: 1.3; }

/* Sidebar */
aside { display: flex; flex-direction: column; gap: 1rem; }
.sidebar-blok { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 8px; padding: 1.25rem; }
.sidebar-blok h3 { font-size: .85rem; font-weight: 800; margin: 0 0 .5rem; text-transform: uppercase; letter-spacing: .04em; }
.sidebar-blok p { font-size: .8rem; color: var(--color-muted); margin: 0 0 .75rem; line-height: 1.5; }
.sidebar-blok ul { list-style: none; padding: 0; margin: 0; }
.sidebar-blok ul li { border-bottom: 1px solid var(--color-border); }
.sidebar-blok ul li:last-child { border-bottom: none; }
.sidebar-blok ul li a { display: block; padding: .4rem 0; font-size: .82rem; color: var(--color-brand); font-weight: 600; }
.sidebar-blok ul li a:hover { text-decoration: underline; }
.btn-cta { display: block; text-align: center; background: var(--color-brand); color: white; padding: .55rem 1rem; border-radius: 6px; font-size: .82rem; font-weight: 700; transition: opacity .15s; }
.btn-cta:hover { opacity: .9; }
.btn-cta--outline { background: transparent; color: var(--color-brand); border: 2px solid var(--color-brand); }
.btn-cta--outline:hover { background: var(--color-brand); color: white; opacity: 1; }

@media (max-width: 800px) {
  .page-grid { grid-template-columns: 1fr; }
  aside { display: none; }
  .bedrijven-grid { grid-template-columns: 1fr; }
}
</style>
