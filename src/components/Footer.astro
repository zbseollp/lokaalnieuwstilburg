<style>
.site-footer { background: #000; color: #9CA3AF; padding: 3rem 0 1.5rem; margin-top: 0; }
.container { max-width: 1200px; margin: 0 auto; padding: 0 1rem; }
.footer-grid {
  display: grid;
  grid-template-columns: 220px repeat(5, 1fr);
  gap: 1.5rem;
  margin-bottom: 2.5rem;
}
.footer-brand img { height: 36px; width: auto; margin-bottom: 1rem; display: block; }
.footer-brand p { font-size: 0.82rem; line-height: 1.65; color: #9CA3AF; margin: 0 0 0.75rem; }
.sitemap-link { font-size: 0.82rem; font-weight: 700; color: #fff; }
.sitemap-link:hover { color: var(--color-brand); }

.footer-col h4 {
  color: var(--color-brand);
  font-size: 0.85rem;
  font-weight: 800;
  margin: 0 0 0.875rem;
  letter-spacing: 0.01em;
}
.footer-col a {
  display: block;
  font-size: 0.82rem;
  color: #9CA3AF;
  margin-bottom: 0.4rem;
  transition: color 0.1s;
}
.footer-col a:hover { color: #fff; }
.footer-bottom {
  border-top: 1px solid rgba(255,255,255,0.08);
  padding-top: 1.25rem;
  font-size: 0.8rem;
  color: #6b7280;
}
@media (max-width: 1024px) {
  .footer-grid { grid-template-columns: repeat(3, 1fr); }
}
@media (max-width: 640px) {
  .footer-grid { grid-template-columns: repeat(2, 1fr); }
}
</style>
